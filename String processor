public class StringProcessor {
    public static void main(String[] args) {
        String originalText = "Radar";
        
        String cleanText = originalText.toLowerCase();
        String reversedText = "";
        
        for (int i = cleanText.length() - 1; i >= 0; i--) {
            reversedText += cleanText.charAt(i);
        }
        
        System.out.println("Original: " + originalText);
        System.out.println("Reversed: " + reversedText);
        System.out.println("Is Palindrome: " + cleanText.equals(reversedText));
        
        System.out.println();
        
        String sentence = "Java,Python,C++,JavaScript";
        String[] languages = sentence.split(",");
        
        System.out.println("Split languages:");
        for (String lang : languages) {
            System.out.println("- " + lang);
        }
    }
}
