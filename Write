import java.io.File;
import java.io.FileWriter;
import java.io.IOException;
import java.util.Scanner;

public class FileOperations {
    public static void main(String[] args) {
        String fileName = "data.txt";

        try {
            FileWriter writer = new FileWriter(fileName);
            writer.write("Java Programming\n");
            writer.write("File Handling Example\n");
            writer.close();
            System.out.println("Successfully written to the file.");
        } catch (IOException e) {
            System.out.println("An error occurred during writing.");
        }

        try {
            File myFile = new File(fileName);
            Scanner reader = new Scanner(myFile);
            System.out.println("\nReading content from file:");
            while (reader.hasNextLine()) {
                String line = reader.nextLine();
                System.out.println(line);
            }
            reader.close();
        } catch (IOException e) {
            System.out.println("An error occurred during reading.");
        }
    }
}
